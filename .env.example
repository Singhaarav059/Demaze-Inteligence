# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's gitignored by design.

# Supabase (run history, saved research)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Scraping
FIRECRAWL_API_KEY=

# Search-grounded discovery + enrichment. Serper (a fallback used here
# previously) was removed 2026-09-01 — see docs/DECISIONS.md — after the
# account went unfunded and the web-research benchmark found no evidence its
# fallback recovered results Tavily itself wasn't also failing to find.
TAVILY_API_KEY=

# LLM provider chain (2026-08-03) — tried in order: Gemini via Vertex AI
# Express Mode (default) -> NVIDIA NIM (kept as a proven-reliable last
# resort). See lib/ai/provider-factory.ts's header comment for the live-test
# results and rationale behind this order (Qwen/DashScope and ZenMux were
# tried first, then removed outright once Gemini beat both on latency and
# quality; Gemini itself moved from an AI Studio key to a Vertex AI Express
# Mode key on 2026-08-03 — get one at
# https://cloud.google.com/vertex-ai/generative-ai/docs/start/express-mode/overview,
# no GCP project/billing required for Express Mode).
GEMINI_VERTEX_API_KEY=
# Overrides the Gemini model. Default (if unset): gemini-3.6-flash.
GEMINI_MODEL=
NVIDIA_NIM_API_KEY=
# Overrides the first/default NVIDIA NIM model. Current default (if unset):
# openai/gpt-oss-120b. Falls back to deepseek-ai/deepseek-v4-pro if it fails.
NVIDIA_NIM_MODEL=

# SEC EDGAR (government filings enrichment source, lib/enrichment/sources/
# edgar-client.ts) — genuinely free, public, no API key or signup required.
# Optional: SEC's fair-access policy asks for a descriptive User-Agent
# identifying the requester, e.g. "Your Company Name contact@you.com". If
# unset, a generic identifying string is used instead (still works, just
# less polite to SEC's infrastructure). Only covers SEC-reporting entities
# (US-listed public companies + some foreign private issuers) — most
# researched companies won't match, and that's expected, not an error.
SEC_EDGAR_USER_AGENT=

# Explee — one EXPLEE_API_KEY/EXPLEE_API_BASE_URL pair covers two separate
# integrations: (1) lib/enrichment/sources/explee-client.ts, the POC
# company-search source for /admin/company-discovery's "Explee POC" panel;
# (2) lib/outbound/shared/explee-client.ts, an OPT-IN Decision-Maker
# Discovery / Email Finder provider (alongside the existing Prospeo
# providers — Prospeo stays active by default). This env var is only a
# fallback for (2); the preferred path is entering the key in
# /admin/outbound/integrations (encrypted at rest, per-capability), same as
# Prospeo. To turn Explee on for either capability, select "explee" as the
# active provider there, or set OUTBOUND_DECISION_MAKER_DISCOVERY_PROVIDER=explee /
# OUTBOUND_EMAIL_FINDER_PROVIDER=explee below. Get a key at
# https://explee.com/api-keys.
EXPLEE_API_KEY=
# Optional override. Default (if unset): https://api.explee.com/public/api/v1
EXPLEE_API_BASE_URL=

# Exa (lib/enrichment/sources/exa-client.ts) — parallel provider experiment,
# not a replacement for Explee/Prospeo yet. One account-level key covers
# Search/Contents/Answer/Websets. Select "exa" as the active provider per
# capability in /admin/outbound/integrations, or via the
# OUTBOUND_*_PROVIDER=exa env fallbacks below, to route that capability
# through Exa instead of the current vendor. Get a key at
# https://dashboard.exa.ai/api-keys.
EXA_API_KEY=
# Optional override. Default (if unset): https://api.exa.ai
EXA_API_BASE_URL=

# Company Discovery provider (lib/enrichment/company-discovery-provider-
# factory.ts's discoverCompanies(), the /admin/company-discovery search).
# Default (if unset): 'exa' — flipped from 'explee' on 2026-09-01 after a
# real benchmark (benchmarks/exa/REPORT.md) found Explee's data quality
# unreliable in ways that reproduced live: a confirmed geo-filter leak,
# revenue figures duplicated across unrelated companies, ~9 wrong-domain
# results in one 40-result page, heavy internal duplication, and a
# min-relevance false-negative pattern that dropped the real company for
# 8/9 known-regression names (Exa found all 9 at #1). Set to 'explee' to
# roll back — Explee's provider and searchExpleeCompanies() are untouched
# and remain fully supported for rollback/debugging.
COMPANY_DISCOVERY_PROVIDER=

# Admin route auth
ADMIN_SECRET=

# Outbound integrations — encrypts stored provider API keys at rest
# (outbound_integrations.credential_encrypted). Generate with:
#   openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

# Outbound provider selection fallback (used only when Supabase has no
# active row for a capability — the Integrations settings page is the
# primary way to choose a provider). One of: mock | <vendor-name>
#
# decision_maker_discovery default is 'exa', not 'mock', matching the live
# DB row flipped 2026-09-01 after benchmarks/exa/REPORT.md found Exa found
# candidates for 10/10 real companies under Demaze's own role vocabulary vs
# Prospeo's 2/10 (Prospeo's title matching is literal, not semantic). This
# only takes effect if Supabase is ever unreachable; the live DB row is
# what actually governs production. Roll back to 'prospeo' here (or in
# /admin/outbound/integrations) if needed — its credential row is untouched.
OUTBOUND_DECISION_MAKER_DISCOVERY_PROVIDER=exa
OUTBOUND_EMAIL_FINDER_PROVIDER=mock
OUTBOUND_ENRICHMENT_PROVIDER=mock
OUTBOUND_SENDING_PROVIDER=mock
OUTBOUND_WARMUP_PROVIDER=mock

# Prospeo (Email Finder + Contact Enrichment provider) — real API key.
# Preferred path is entering this in /admin/outbound/integrations (encrypted
# at rest); this env var is a fallback used only when no DB credential is
# stored for that capability. Also select "prospeo" as the active provider
# in Outbound Integrations, or set OUTBOUND_EMAIL_FINDER_PROVIDER=prospeo /
# OUTBOUND_ENRICHMENT_PROVIDER=prospeo above.
PROSPEO_API_KEY=

# Gmail (Email Sending provider) — interim sending provider until a paid
# cold-outreach platform (Smartlead/Instantly) is chosen. Unlike Prospeo,
# this is OAuth, not a pasted API key:
#   1. Google Cloud Console -> APIs & Services -> enable "Gmail API".
#   2. OAuth consent screen -> add the gmail.send scope.
#   3. Credentials -> Create OAuth client ID (type: Web application).
#   4. Add an Authorized redirect URI matching exactly:
#      <your-app-origin>/api/admin/outbound/oauth/gmail/callback
#      (e.g. http://localhost:3000/... for local dev)
#   5. Put that Client ID/Secret below.
#   6. In /admin/outbound/integrations, select "gmail" under Email Sending
#      and click "Connect with Google" — this is a real Google consent
#      screen the account owner must click through themselves; nothing here
#      can do that step automatically.
# The resulting refresh token is stored encrypted (alongside the client
# id/secret used to obtain it) in outbound_integrations.credential_encrypted,
# same as every other vendor credential in this app.
#
# This ONE redirect URI is shared by every Google-connected flow in this app
# (Email Sending here, the Warm-Up engine below, and any future one) — see
# lib/outbound/shared/gmail-oauth.ts. Only this single URL (per public
# domain you use — custom + *.up.railway.app each need their own entry, if
# you use both) ever needs registering in Google Cloud Console, no matter
# how many Google-connected flows this app grows to have.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional — only needed if the app's own request origin doesn't match what
# you registered in Google Cloud Console (e.g. behind a proxy/tunnel).
GOOGLE_OAUTH_REDIRECT_URI=

# Real DIY email warmup engine (2026-08-04) — a SEPARATE OAuth connection
# per pool mailbox from the Email Sending capability above, using the same
# GOOGLE_CLIENT_ID/SECRET (no new Google Cloud project needed) and the same
# shared callback URL (see above), but a broader gmail.modify scope. Connect
# mailboxes via "Connect a Gmail mailbox" on /admin/outbound/warmup — that
# button drives its own OAuth flow, nothing here needs to be filled in to
# connect a mailbox.
#
# Make sure the OAuth app is in Testing mode with every Gmail account you'll
# connect listed as a test user (avoids a Google verification review for the
# gmail.modify sensitive scope). No separate redirect URI to add here —
# it reuses GOOGLE_OAUTH_REDIRECT_URI above.

# Set to "true" to turn on the autonomous background scheduler (a real
# setInterval inside the running server process — see instrumentation.ts)
# that ticks the warmup engine on its own, forever, sending/processing real
# emails between your connected mailboxes with no further action from you.
# UNSET/anything else = off, everywhere, including local dev — this is the
# deliberate safe default; nothing sends anything until you flip this
# yourself, separately from deploying this code. The manual "Run Tick Now"
# button on /admin/outbound/warmup works regardless of this setting.
WARMUP_ENGINE_ENABLED=
# How often the autonomous scheduler ticks, in milliseconds. Default (if
# unset): 1800000 (30 minutes).
WARMUP_ENGINE_INTERVAL_MS=

# Absolute origin (no trailing slash, e.g. https://demaze.yourapp.com) this
# app is reachable at from the public internet — used ONLY to build the
# email-open-tracking pixel URL embedded in sent emails
# (lib/outbound/sending/providers/gmail.ts). A localhost value is useless
# here: real email clients load this from outside your machine, not from
# the dev server. Must be set in BOTH .env.local (for local testing against
# a tunneled/deployed origin) and Railway's production env config. Unset =
# emails send as plain text with no tracking pixel and no HTML part at all
# (byte-identical to this app's original send behavior) — open tracking and
# the automatic follow-up engine (FOLLOWUP_ENGINE_ENABLED below) both stay
# fully inert without this.
OUTBOUND_TRACKING_BASE_URL=

# Automatic follow-up engine (2026-08-05) — same shape as the warmup engine
# above, a separate autonomous setInterval in instrumentation.ts. On each
# tick: checks Gmail replies for active campaigns, then sends the next due
# follow-up for any contact that (a) is past the existing follow-up cadence
# AND (b) has never opened a previous email in the sequence
# (OUTBOUND_TRACKING_BASE_URL must be configured for "opened" to ever be
# knowable — if it isn't, this engine deliberately fails CLOSED and skips
# auto-sending entirely rather than guessing, see
# lib/outbound/sending/followup-engine/tick-logic.ts). UNSET/anything else =
# off everywhere, including local dev — same deliberate safe default as
# WARMUP_ENGINE_ENABLED; nothing auto-sends until you flip this yourself.
# The manual "Run Follow-Up Engine Tick Now" button on
# /admin/outbound/followups works regardless of this setting.
FOLLOWUP_ENGINE_ENABLED=
# How often the autonomous scheduler ticks, in milliseconds. Default (if
# unset): 3600000 (1 hour) — follow-up due-ness is day-granularity, so
# hourly is plenty and keeps Gmail API usage low.
FOLLOWUP_ENGINE_INTERVAL_MS=
# Global sending kill switch (Production Hardening Master Plan, Step 7.5).
# Checked in lib/outbound/sending/provider-factory.ts's sendEmail() —
# the single choke point every real send path (manual send, "Process
# Follow-ups", the automatic follow-up engine) funnels through, so this
# overrides every campaign-level setting (daily limits, send windows,
# per-campaign pause) at once. Opposite default shape from
# WARMUP_ENGINE_ENABLED/FOLLOWUP_ENGINE_ENABLED above on purpose — this is
# a brake, not an opt-in throttle: UNSET or anything other than the exact
# string 'false' = sending stays enabled (preserves current behavior).
# Set to 'false' to immediately stop all outbound sending, e.g. during an
# incident.
OUTBOUND_SEND_ENABLED=
